generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WorkOutcome {
  bookingUuid       String   @id @map("booking_uuid") @db.Uuid
  bookingIdAlias    String   @unique @map("booking_id_alias") @db.VarChar(50)
  bookingNo         String   @map("booking_no") @db.VarChar(50)
  client            String   @db.VarChar(200)
  service           String   @db.VarChar(100)
  serviceDate       String   @map("service_date")
  amountDue         Decimal? @map("amount_due") @db.Decimal(10, 2)
  status            String   @default("PENDING") @db.VarChar(32)
  postServiceStatus String   @default("Pending Review") @map("post_service_status") @db.VarChar(50)
  arrivalTime       String?  @map("arrival_time") @db.VarChar(20)
  additionalMaterials String[] @default([]) @map("additional_materials")
  issueReported     Boolean  @default(false) @map("issue_reported")
  issueDetails      String?  @map("issue_details")
  completionNotes   String?  @map("completion_notes")
  finalizedBy       String?  @map("finalized_by") @db.Uuid
  finalizedAt       DateTime? @map("finalized_at") @db.Timestamptz(6)
  confirmCommandId  String?  @map("confirm_command_id") @db.Uuid
  bookingVersion    Int?     @map("booking_version")
  lastError         String?  @map("last_error")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("work_outcomes")
}

model Collection {
  id               String   @id @default(uuid()) @db.Uuid
  idempotencyKey   String   @unique @map("idempotency_key") @db.Uuid
  bookingUuid      String   @map("booking_uuid") @db.Uuid
  bookingIdAlias   String   @map("booking_id_alias") @db.VarChar(50)
  bookingNo        String   @map("booking_no") @db.VarChar(50)
  clientName       String   @map("client_name") @db.VarChar(200)
  garage           String   @default("Unassigned") @db.VarChar(120)
  deliveryType     String   @default("Inhouse") @map("delivery_type") @db.VarChar(20)
  plateNumber      String   @default("N/A") @map("plate_number") @db.VarChar(20)
  assignedTeam     String   @default("Unassigned") @map("assigned_team") @db.VarChar(100)
  amount           Decimal  @db.Decimal(10, 2)
  method           String   @db.VarChar(20)
  reference        String   @db.VarChar(100)
  collectedAt      DateTime @map("collected_at") @db.Timestamptz(6)
  businessDate     String   @map("business_date") @db.VarChar(10)
  status           String   @default("PENDING") @db.VarChar(20)
  recordedBy       String   @map("recorded_by") @db.Uuid
  verifiedBy       String?  @map("verified_by") @db.Uuid
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  rejectedBy       String?  @map("rejected_by") @db.Uuid
  rejectedAt       DateTime? @map("rejected_at") @db.Timestamptz(6)
  decisionReason   String?  @map("decision_reason") @db.VarChar(500)
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  paymentCommandId String?  @map("payment_command_id") @db.Uuid
  paymentExpectedVersion Int? @map("payment_expected_version")
  projectionError  String?  @map("projection_error")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  refundRequests   RefundRequest[]

  @@index([businessDate, status])
  @@index([bookingUuid])
  @@map("collections")
}

model RefundRequest {
  id             String   @id @default(uuid()) @db.Uuid
  collectionId   String   @map("collection_id") @db.Uuid
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  bookingUuid    String   @map("booking_uuid") @db.Uuid
  bookingNo      String   @map("booking_no") @db.VarChar(50)
  clientName     String   @map("client_name") @db.VarChar(200)
  amount         Decimal  @db.Decimal(10, 2)
  reason         String   @db.VarChar(500)
  status         String   @default("Requested") @db.VarChar(20)
  requestedBy    String   @map("requested_by") @db.Uuid
  requestedAt    DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy      String?  @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionReason String?  @map("decision_reason") @db.VarChar(500)
  refundId       String?  @unique @map("refund_id") @db.Uuid
  refund         Refund?  @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([requestedBy, requestedAt])
  @@map("refund_requests")
}

model ApprovalAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  itemType  String   @map("item_type") @db.VarChar(20)
  itemId    String   @map("item_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(30)
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemType, itemId, createdAt])
  @@index([actorId, createdAt])
  @@map("approval_audit_events")
}

model ApprovalEventReceipt {
  eventId   String   @id @map("event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("approval_event_receipts")
}

model Refund {
  id           String   @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  reason       String   @db.VarChar(500)
  refundedAt   DateTime @map("refunded_at") @db.Timestamptz(6)
  businessDate String   @map("business_date") @db.VarChar(10)
  approvedBy   String   @map("approved_by") @db.Uuid
  paymentCommandId String? @map("payment_command_id") @db.Uuid
  paymentExpectedVersion Int? @map("payment_expected_version")
  desiredPaymentHold Boolean @default(false) @map("desired_payment_hold")
  projectionState String @default("PENDING") @map("projection_state") @db.VarChar(20)
  projectionError String? @map("projection_error")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  approvalRequest RefundRequest?

  @@index([collectionId])
  @@index([businessDate])
  @@map("refunds")
}

model DailySubmission {
  date        String   @id @db.VarChar(10)
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(6)
  submittedBy String   @map("submitted_by") @db.Uuid

  @@map("daily_submissions")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  role      String?  @db.VarChar(40)
  action    String   @db.VarChar(100)
  path      String   @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("audit_events")
}
