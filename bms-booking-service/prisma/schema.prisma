generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id                        String   @id @default(uuid()) @db.Uuid
  bookingId                 String   @unique @map("booking_id") @db.VarChar(50)
  bookingNo                 String   @unique @map("booking_no") @db.VarChar(50)
  client                    String   @db.VarChar(200)
  fullName                  String?  @map("full_name") @db.VarChar(200)
  service                   String   @db.VarChar(100)
  amount                    Decimal? @db.Decimal(10, 2)
  downpayment               Decimal? @db.Decimal(10, 2)
  totalAmount               String?  @map("total_amount")
  requestedPaymentMethod    String?  @map("requested_payment_method") @db.VarChar(100)
  serviceType               String?  @map("service_type") @db.VarChar(120)
  deliveryCategory          String?  @map("delivery_category") @db.VarChar(40)
  selectedTruck             Json?    @map("selected_truck")
  date                      String
  preferredTime             String?  @map("preferred_time") @db.VarChar(100)
  pickupAddress             String?  @map("pickup_address")
  deliveryAddress           String?  @map("delivery_address")
  pickupLandmark            String?  @map("pickup_landmark")
  deliveryLandmark          String?  @map("delivery_landmark")
  address                   String?
  contact                   String?  @db.VarChar(100)
  email                     String?  @db.VarChar(255)
  deliveryLocation          String?  @map("delivery_location")
  estimatedItems            Int?     @map("estimated_items")
  itemDetails               String?  @map("item_details")
  specialInstructions       String?  @map("special_instructions")
  notes                     String?
  servicesAvailed           String[] @default([]) @map("services_availed")
  protectiveMaterials       String[] @default([]) @map("protective_materials")
  additionalServicesAvailed Json?    @map("additional_services_availed")
  hasInsurance              Boolean  @default(false) @map("has_insurance")
  permitRequired            Boolean  @default(false) @map("permit_required")
  status                    String   @default("For Plotting") @db.VarChar(40)
  discrepancyNote           String?  @map("discrepancy_note")
  flagged                   Boolean  @default(false)
  version                   Int      @default(1)
  operationalHold           Boolean  @default(false) @map("operational_hold")
  assignmentReference       String?  @map("assignment_reference") @db.Uuid
  paymentHold               Boolean  @default(false) @map("payment_hold")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  welincLink                WelincBookingLink?
  changeRequests            BookingChangeRequest[]
  notifications             Notification[]

  @@index([createdAt])
  @@map("bookings")
}

model BookingChangeRequest {
  id              String   @id @default(uuid()) @db.Uuid
  bookingUuid     String   @map("booking_uuid") @db.Uuid
  booking         Booking  @relation(fields: [bookingUuid], references: [id], onDelete: Cascade)
  type            String   @db.VarChar(20)
  payloadBefore   Json?    @map("payload_before")
  payloadAfter    Json     @map("payload_after")
  reason          String?  @db.VarChar(500)
  status          String   @default("Pending") @db.VarChar(20)
  requestedBy     String   @map("requested_by") @db.Uuid
  requestedAt     DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedBy       String?  @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionReason  String?  @map("decision_reason") @db.VarChar(500)
  bookingVersion  Int      @map("booking_version")

  @@index([status, requestedAt])
  @@index([requestedBy, requestedAt])
  @@map("booking_change_requests")
}

model ApprovalAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  itemType  String   @map("item_type") @db.VarChar(20)
  itemId    String   @map("item_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(30)
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemType, itemId, createdAt])
  @@index([actorId, createdAt])
  @@map("approval_audit_events")
}

model ApprovalOutbox {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(40)
  aggregateId String   @map("aggregate_id") @db.Uuid
  payload     Json
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError   String?  @map("last_error")

  @@index([processedAt, createdAt])
  @@map("approval_outbox")
}

model InternalBookingCommand {
  commandId   String   @id @map("command_id") @db.Uuid
  bookingUuid String   @map("booking_uuid") @db.Uuid
  kind        String   @db.VarChar(40)
  payloadHash String   @map("payload_hash") @db.VarChar(64)
  result      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bookingUuid, createdAt])
  @@map("internal_booking_commands")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  role      String?  @db.VarChar(40)
  action    String   @db.VarChar(100)
  path      String   @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("audit_events")
}

model WelincBookingLink {
  externalBookingId String   @id @map("external_booking_id") @db.VarChar(100)
  bookingUuid       String   @unique @map("booking_uuid") @db.Uuid
  lastOccurredAt    DateTime @map("last_occurred_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking           Booking  @relation(fields: [bookingUuid], references: [id], onDelete: Cascade)

  @@map("welinc_booking_links")
}

model WelincWebhookEvent {
  eventId           String   @id @map("event_id") @db.VarChar(128)
  eventType         String   @map("event_type") @db.VarChar(100)
  externalBookingId String   @map("external_booking_id") @db.VarChar(100)
  payloadSha256     String   @map("payload_sha256") @db.VarChar(64)
  payload           Json
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  result            String   @db.VarChar(30)
  reason            String?  @db.VarChar(100)
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy        String?  @map("reviewed_by") @db.Uuid
  reviewResolution  String?  @map("review_resolution") @db.VarChar(30)
  reviewNote        String?  @map("review_note") @db.VarChar(500)

  @@index([externalBookingId, occurredAt])
  @@map("welinc_webhook_events")
}

model ServiceOffering {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(500)
  duration    String?  @db.VarChar(50)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  // What the customer gets, how they can pay, and what isn't covered: shown with View details
  // on Services Offered and in the New Booking wizard (spec bms/0013)
  inclusions     String[] @default([])
  paymentOptions String[] @default([]) @map("payment_options")
  exclusions     String[] @default([])
  // Added once per service when the booking is paid in cash (spec bms/0013); separate from the
  // booking's cash-on-delivery surcharge
  cashCharge     Decimal  @default(0) @map("cash_charge") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("service_offerings")
}

model BookingServiceCatalog {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("booking_services_catalog")
}

model TruckRate {
  id           String   @id @default(uuid()) @db.Uuid
  truckTypeId  String   @map("truck_type_id") @db.VarChar(120)
  locationCode String   @map("location_code") @db.VarChar(10)
  name         String   @db.VarChar(200)
  dimensions   String   @db.VarChar(200)
  inclusions   String   @db.VarChar(500)
  rate6hr      Decimal  @map("rate_6hr") @db.Decimal(10, 2)
  imageUrl     String?  @map("image_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([truckTypeId, locationCode, name])
  @@index([truckTypeId, locationCode, isActive])
  @@map("truck_rates")
}

model ProtectiveMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(500)
  price       Decimal  @default(0) @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("protective_materials_catalog")
}

// In-app notifications (spec bms/0021). Each row is for one role (everyone holding it) or one
// person. Dispatch and Completion deliver theirs through /internal/notifications; dedupeKey makes a
// repeated delivery a no-op.
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  dedupeKey       String    @unique @map("dedupe_key") @db.VarChar(200)
  recipientRole   String?   @map("recipient_role") @db.VarChar(40)
  recipientUserId String?   @map("recipient_user_id") @db.Uuid
  // Who caused it; they don't see their own notification
  actorId         String?   @map("actor_id") @db.Uuid
  kind            String    @db.VarChar(60)
  title           String    @db.VarChar(200)
  message         String    @db.VarChar(500)
  href            String?   @db.VarChar(300)
  // Removed with its booking (a deleted WeLinc import), so the bell never points at a booking that's gone
  bookingUuid     String?   @map("booking_uuid") @db.Uuid
  booking         Booking?  @relation(fields: [bookingUuid], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reads           NotificationRead[]

  @@index([recipientRole, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// Who has read which notification, so read state follows the person across browsers.
model NotificationRead {
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamptz(6)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// Customer emails wait here and are sent by a timer, retried with a growing wait on failure
// (spec bms/0021). The content is rendered when queued, so a later edit can't change what was said.
model CustomerEmail {
  id            String    @id @default(uuid()) @db.Uuid
  bookingUuid   String?   @map("booking_uuid") @db.Uuid
  bookingNo     String    @map("booking_no") @db.VarChar(50)
  kind          String    @db.VarChar(60)
  recipient     String    @db.VarChar(255)
  subject       String    @db.VarChar(300)
  textBody      String    @map("text_body")
  htmlBody      String    @map("html_body")
  // PENDING, SENT, FAILED (gave up) or SKIPPED (SMTP not configured)
  status        String    @default("PENDING") @db.VarChar(12)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  lastError     String?   @map("last_error") @db.VarChar(1000)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("customer_emails")
}

// CLI-only metadata keeps demo dates and VMMS resource ids stable across reruns.
model DemoSeedRun {
 datasetKey String @id @map("dataset_key") @db.VarChar(60)
 manifest Json
 phase String @default("planned") @db.VarChar(30)
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
 @@map("bms_demo_seed_runs")
}

model DemoSeedRecord {
 datasetKey String @map("dataset_key") @db.VarChar(60)
 tableName String @map("table_name") @db.VarChar(60)
 recordId String @map("record_id") @db.VarChar(80)
 bookingUuid String @map("booking_uuid") @db.Uuid
 rowHash String @map("row_hash") @db.Char(64)
 @@id([tableName,recordId])
 @@index([datasetKey,bookingUuid], map:"bms_demo_seed_records_dataset_idx")
 @@map("bms_demo_seed_records")
}
