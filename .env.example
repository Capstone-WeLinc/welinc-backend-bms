# Groq AI settings belong in ../welinc-backend-bms-analytics-ai/.env.
AUTH_ISSUER=http://localhost:3000/auth
AUTH_JWKS_URL=http://auth-service:3001/auth/.well-known/jwks.json
AUTH_INTERNAL_URL=http://auth-service:3001
AUTH_CLIENT_ID=bms
AUTH_CLIENT_PRIVATE_KEY=
CUSTOMER_TRACKING_SECRET=
BMS_INTERNAL_SERVICE_KEY=
WEB_APP_URL=http://localhost:8003
CORS_ORIGINS=http://localhost:8003
PORTAL_URL=http://localhost:8000
AUTH_PUBLIC_URL=http://localhost:3000/auth
API_PUBLIC_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
BMS_WELINC_BOOKING_WEBHOOK_SECRET=
BMS_WELINC_WEBHOOK_API_KEY=
# Optional booking integrations. Leave blank to disable the corresponding integration.
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CUSTOMER_SUPPORT_EMAIL=
CUSTOMER_SUPPORT_PHONE=
BOOKING_API_URL=http://bms-booking:3021
DISPATCH_API_URL=http://bms-dispatch:3022
COMPLETION_API_URL=http://bms-completion:3023
ANALYTICS_API_URL=http://bms-analytics:3025
ANALYTICS_PROJECTION_URL=http://bms-analytics-projection:3024
VMMS_INTERNAL_URL=http://vmms-backend:3010
ANALYTICS_READ_MODEL_DATABASE_URL=
# Background projection interval, in milliseconds.
PROJECTION_INTERVAL_MS=10000

# Whole-process PostgreSQL connection budget (hosted value: 2).
DB_POOL_MAX=2

# Seed jobs only. Never set SEED_ALLOW on production jobs.
SEED_ALLOW=
BMS_SEED_ANCHOR_DATE=
# Optional JSON input for staging demo jobs; local orchestration passes stdin instead.
BMS_SEED_MANIFEST=
