PORT=3002
DATABASE_URL="postgresql://bms_booking_user:bms_booking_local_only@localhost:5434/bms_booking_db?schema=public"
# Local Auth database lookup for approval submitter and reviewer names.
AUTH_DATABASE_URL="postgresql://welinc_user:welinc_pass@127.0.0.1:5433/welinc_db"
# Transitional local JWT verification only. Replace with the auth owner's approved contract before cutover.
JWT_SECRET=
BMS_INTERNAL_SERVICE_KEY=
DISPATCH_API_URL=http://127.0.0.1:3003
COMPLETION_API_URL=http://127.0.0.1:3004
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BMS_WELINC_BOOKING_WEBHOOK_SECRET=
# API key for WeLinc / Wix webhooks (supports ?apiKey=... query parameter or X-Api-Key header)
BMS_WELINC_WEBHOOK_API_KEY=
# Optional until route estimation is used. Enable the Google Routes API for this key.
GOOGLE_MAPS_API_KEY=
# Optional; defaults to GOOGLE_MAPS_API_KEY when unset.
GOOGLE_GEOCODING_API_KEY=
# Optional SMTP settings for customer booking change notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WeLinc Logistics <no-reply@welinc.com>
CUSTOMER_TRACKING_BASE_URL=http://localhost:5173
CUSTOMER_TRACKING_SECRET=
CUSTOMER_SUPPORT_EMAIL=
